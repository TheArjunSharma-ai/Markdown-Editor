{
  "name": "portable-markdown-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "exports": {
    ".": "./dist/markdown-editor.es.js",
    "./style.css": "./dist/markdown-editor.css"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "npm run build && vite --host 127.0.0.1 --port 5173 --strictPort",
    "check": "tsc -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.js",
    "build:demo": "vite build && vite build --config vite.demo.config.js",
    "preview": "vite preview --outDir site --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/markdown": "^1.0.0",
    "dompurify": "^3.2.7",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "5.0.5"
  }
}
